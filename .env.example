# Optional: set this if you want the assistant to use a real OpenAI-compatible LLM.
# Never commit your actual key to GitHub.
OPENAI_API_KEY=
# Optional; leave blank for the default OpenAI API.
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Local paths; normally you can keep these defaults.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_PATH=models/churn_model
